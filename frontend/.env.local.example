# Where the FastAPI backend lives. The dashboard prefixes every call with this.
# The API's domain routes are mounted under /api (see app.main), so include it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Dev-stub identity sent as the X-User-Id header on every request. Leave blank to
# use the backend's seeded dev user (recommended for local use).
NEXT_PUBLIC_USER_ID=
