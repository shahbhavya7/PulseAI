# Keep the Docker build context small and secret-free.

# Secrets & local env — never bake these into an image
.env
*.env
!.env.example
frontend/.env.local

# Python caches / virtualenvs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next build artifacts (rebuilt inside the image)
frontend/node_modules/
frontend/.next/
frontend/out/

# VCS, editor, OS
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# Docs & scratch (not needed at runtime)
docs/
tests/
*.md
!README.md
