# Copy to .env and fill in. No secrets are committed to the repo.
# ---- App ----
PULSE_ENV=local
PULSE_DEBUG=true
PULSE_LOG_LEVEL=INFO
PULSE_API_PREFIX=/api
# Browser origins allowed to call the API (the Next.js dashboard). Comma-separated.
PULSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Postgres (pgvector image) ----
# Full DSN takes precedence if set; otherwise it is assembled from the parts below.
# PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse
#
# These "localhost" defaults are for running the backend directly on your host
# (the manual/no-Docker setup in the README) against `docker compose up -d
# postgres redis`. If you're running the APP itself in Docker (docker-compose.yml
# or `docker run` of the ghcr image), "localhost" inside that container is the
# container itself, not your host or a sibling container — it will hang waiting
# for Postgres and then fail. docker-compose.yml already overrides these to the
# service names (postgres/redis) for you. Running the ghcr image standalone with
# `docker run`, set these to a host your container can actually reach, e.g.
# PULSE_POSTGRES_HOST=host.docker.internal (Docker Desktop) or a real hostname/IP.
PULSE_POSTGRES_HOST=localhost
PULSE_POSTGRES_PORT=5432
PULSE_POSTGRES_USER=pulse
PULSE_POSTGRES_PASSWORD=pulse
PULSE_POSTGRES_DB=pulse

# ---- Redis ----
# Same caveat as Postgres above: "localhost" only works for a host-run backend.
PULSE_REDIS_URL=redis://localhost:6379/0

# ---- OpenAI (Phase 2 AI pipeline) ----
# Required for live analysis. Leave unset to run everything else; the AI
# pipeline then degrades gracefully (clear error, no crash).
# PULSE_OPENAI_API_KEY=sk-...
PULSE_OPENAI_MODEL=gpt-5-mini
PULSE_OPENAI_TIMEOUT_SECONDS=30
PULSE_OPENAI_REASONING_EFFORT=minimal
PULSE_AI_CACHE_TTL_SECONDS=604800
PULSE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Classify uploaded/pasted tickets automatically in the same request (no manual
# "Analyse" click). Degrades gracefully to a placeholder if the model is down.
PULSE_AUTO_ANALYZE_ON_UPLOAD=true

# ---- Chat (Phase 6: hybrid retrieval + cross-session memory) ----
PULSE_CHAT_RETRIEVAL_K=6        # semantic issue examples per question
PULSE_CHAT_MEMORY_K=3           # prior session summaries recalled on a new session
PULSE_CHAT_HISTORY_WINDOW=12    # recent transcript turns kept in the prompt
PULSE_CHAT_IDLE_MINUTES=30      # a session idle this long is swept into memory

# ---- Auth (Phase 5: Google / Apple OIDC) ----
# Session JWT signing secret + OAuth state secret. Generate strong random values
# in any non-local env, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PULSE_JWT_SECRET=change-me-to-a-long-random-string
PULSE_OAUTH_STATE_SECRET=change-me-to-another-long-random-string
# Cookie flags — set SECURE=true behind HTTPS in production.
PULSE_SESSION_COOKIE_SECURE=false
# Email + password sign-in (on by default; set false to force OAuth-only).
PULSE_EMAIL_LOGIN_ENABLED=true
# Password given to the legacy dev user (dev@pulseai.local) by migration 0005,
# so the existing local data is reachable. Change or ignore as you like.
PULSE_DEV_PASSWORD=pulseai-dev
# Where the OAuth provider redirects back, and where we bounce the browser after.
PULSE_BACKEND_BASE_URL=http://localhost:8000
PULSE_FRONTEND_BASE_URL=http://localhost:3000

# Google OIDC — from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: http://localhost:8000/api/auth/callback/google
# PULSE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# PULSE_GOOGLE_CLIENT_SECRET=xxxxx

# Apple Sign In — from the Apple Developer portal (needs a paid account).
# The Services ID, your Team ID, the Key ID, and the .p8 private key contents.
# Authorized redirect URI: http://localhost:8000/api/auth/callback/apple
# PULSE_APPLE_CLIENT_ID=com.yourorg.pulseai.web
# PULSE_APPLE_TEAM_ID=XXXXXXXXXX
# PULSE_APPLE_KEY_ID=XXXXXXXXXX
# PULSE_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
