# Copy to .env and fill in. No secrets are committed to the repo.
# ---- App ----
PULSE_ENV=local
PULSE_DEBUG=true
PULSE_LOG_LEVEL=INFO
PULSE_API_PREFIX=/api

# ---- Postgres (pgvector image) ----
# Full DSN takes precedence if set; otherwise it is assembled from the parts below.
# PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse@localhost:5432/pulse
PULSE_POSTGRES_HOST=localhost
PULSE_POSTGRES_PORT=5432
PULSE_POSTGRES_USER=pulse
PULSE_POSTGRES_PASSWORD=pulse
PULSE_POSTGRES_DB=pulse

# ---- Redis ----
PULSE_REDIS_URL=redis://localhost:6379/0

# ---- OpenAI (Phase 2 AI pipeline) ----
# Required for live analysis. Leave unset to run everything else; the AI
# pipeline then degrades gracefully (clear error, no crash).
# PULSE_OPENAI_API_KEY=sk-...
PULSE_OPENAI_MODEL=gpt-5-mini
PULSE_OPENAI_TIMEOUT_SECONDS=30
PULSE_OPENAI_REASONING_EFFORT=minimal
PULSE_AI_CACHE_TTL_SECONDS=604800
PULSE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
